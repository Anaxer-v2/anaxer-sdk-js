{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "@anaxer/schemas/public/v1": [
        "./vendor/schemas/public/v1/index.ts"
      ],
      "@anaxer/schemas/*": [
        "./vendor/schemas/*"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "vendor",
    "tsup.config.ts",
    "vitest.config.ts"
  ]
}
